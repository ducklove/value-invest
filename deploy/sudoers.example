# value-invest 배포 계정용 sudoers 예제.
# sudo visudo -f /etc/sudoers.d/value-invest-deploy 로 설치하고 sudo visudo -c 로 확인한다.
# 실제 배포 경로와 계정에 맞게 조정할 것. 이 파일은 자동 설치하지 않는다.
# 유닛 설치 권한은 master 작성자를 신뢰한다는 뜻이며 권한 격리 수단이 아니다.
# 설치 전 기존 유닛을 백업하고, 실패 시 해당 파일과 타이머 상태를 복구한다.
cantabile ALL=(root) NOPASSWD: /bin/systemctl daemon-reload
cantabile ALL=(root) NOPASSWD: /bin/systemctl restart value-invest.service
cantabile ALL=(root) NOPASSWD: /bin/systemctl --no-pager status value-invest.service
cantabile ALL=(root) NOPASSWD: /usr/bin/cmp -s /home/cantabile/Works/value_invest/value-invest-notify@.service /etc/systemd/system/value-invest-notify@.service
cantabile ALL=(root) NOPASSWD: /usr/bin/cp /home/cantabile/Works/value_invest/value-invest-notify@.service /etc/systemd/system/value-invest-notify@.service
cantabile ALL=(root) NOPASSWD: /usr/bin/cp /home/cantabile/Works/value_invest/.deploy-state/*/units/value-invest-notify@.service /etc/systemd/system/value-invest-notify@.service
cantabile ALL=(root) NOPASSWD: /usr/bin/rm -f /etc/systemd/system/value-invest-notify@.service
cantabile ALL=(root) NOPASSWD: /bin/systemctl disable --now value-invest-notify@.service
