[Unit]
Description=AI morning briefing push Monday through Saturday at 07:30 KST

[Timer]
# 월~토 07:30 — 07:00에 별도 저장한 원화 평가액·해외그룹 성과로,
# 평일은 KRX 개장(09:00) 전에, 토요일은 금요일 해외장 마감 결과를 보낸다.
# Persistent=false 인 이유: 브리핑은 '아침'이라는 시점 자체가 가치다.
# 다운타임 후 부팅 시 따라잡기(catch-up)로 한낮/저녁에 뒷북 브리핑을
# 푸시하면 정보 가치는 없고 스팸이 된다 — 놓친 날은 그냥 건너뛴다.
OnCalendar=Mon..Sat *-*-* 07:30:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=1m

[Install]
WantedBy=timers.target
