{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-compass:schema:summary:nps-tracker:1",
  "title": "nps-tracker summary.json data (v1)",
  "description": "NPS domestic-equity portfolio headline: summary (total value, NAV, returns), fund-level asset allocation and the TOP holdings by weight. Replaces the 313 KB current.json.",
  "type": "object",
  "required": ["lastUpdated", "summary", "allocation", "top"],
  "properties": {
    "lastUpdated": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "summary": {
      "type": "object",
      "required": ["totalValue", "nav", "count", "todayPct", "asOf"],
      "properties": {
        "totalValue": {"$ref": "#/$defs/num", "description": "KRW"},
        "nav": {"$ref": "#/$defs/num"},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "todayPct": {"$ref": "#/$defs/num"},
        "mtdPct": {"$ref": "#/$defs/num"},
        "ytdPct": {"$ref": "#/$defs/num"},
        "asOf": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "allocation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["classes"],
          "properties": {
            "asOf": {"type": ["string", "null"]},
            "estimated": {"type": "boolean"},
            "classes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label", "pct"],
                "properties": {
                  "key": {"type": "string", "minLength": 1},
                  "label": {"type": "string", "minLength": 1},
                  "pct": {"$ref": "#/$defs/num"},
                  "target": {"$ref": "#/$defs/num", "description": "Published target weight, % (optional; hub falls back to its constant)."}
                }
              }
            }
          }
        }
      ]
    },
    "top": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "name", "weight"],
        "properties": {
          "code": {"type": "string", "pattern": "^[0-9A-Z]{6}$"},
          "name": {"type": ["string", "null"]},
          "weight": {"$ref": "#/$defs/num", "description": "% of the tracked portfolio."},
          "marketValue": {"$ref": "#/$defs/num", "description": "KRW"},
          "changePct": {"$ref": "#/$defs/num"},
          "ownershipPct": {"$ref": "#/$defs/num"},
          "sector": {"type": ["string", "null"]}
        }
      }
    },
    "positionsAsOf": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Optional. Filing date label of the year-end holdings behind 'weights' and 'ownership' (not the price date)."},
    "weights": {
      "type": "object",
      "description": "Optional. Compact code -> % of the tracked portfolio at the price date (3 decimals). Built on estimated share counts.",
      "propertyNames": {"pattern": "^[0-9A-Z]{6}$"},
      "additionalProperties": {"type": "number"}
    },
    "ownership": {
      "type": "object",
      "description": "Optional. Compact code -> filed ownership, % (2 decimals). Codes without a filed value are left out.",
      "propertyNames": {"pattern": "^[0-9A-Z]{6}$"},
      "additionalProperties": {"type": "number"}
    },
    "ownershipChange": {
      "description": "Optional. Filed ownership change between the two latest year-end archives. Null while fewer than two archives exist.",
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["from", "to", "comparable", "changes"],
          "properties": {
            "from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "to": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "comparable": {"type": "boolean", "description": "False when nearly every code keeps the same ownership, which means the source re-issued the same file; 'changes' is then empty."},
            "changes": {
              "type": "object",
              "description": "Code -> ownership change in %p, moved codes only.",
              "propertyNames": {"pattern": "^[0-9A-Z]{6}$"},
              "additionalProperties": {"type": "number"}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "num": {"type": ["number", "null"]}
  }
}
