[Unit]
Description=Value Invest — failure notifier for %i
# Not tied to network target etc. — this runs when a failure already happened.

[Service]
Type=oneshot
User=cantabile
Group=cantabile
# 허브 공용 알림(관리자 채널)으로 먼저 보내고, 허브가 응답하지 않을 때만
# NTFY_TOPIC(선택)으로 ntfy.sh 에 보낸다 — scripts/notify_failure.sh 참고.
# .env 에서 INTERNAL_API_TOKEN·NTFY_TOPIC 을 읽는다.
EnvironmentFile=-/home/cantabile/Works/value_invest/.env
ExecStart=/bin/bash /home/cantabile/Works/value_invest/scripts/notify_failure.sh %i
# Keep the process from lingering.
TimeoutStartSec=30s
