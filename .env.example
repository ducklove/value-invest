# value-invest 설정 단일 소스 — 이 파일을 `.env` 로 복사해서 채운다.
#
# 규칙
#   - 설정과 시크릿은 전부 `.env` 하나에 둔다. 프로필별 파일(.env.production 등)
#     이나 keys.txt 같은 별도 파일은 더 이상 읽지 않는다.
#   - 프로세스 환경변수(systemd `Environment=`, 쉘 export, 테스트의 patch.dict)가
#     `.env` 보다 우선한다. `.env` 는 비어 있는 키만 채운다.
#   - 새 설정을 추가하면 코드 기본값에만 두지 말고 여기에 먼저 문서화한다.
#   - `.env` 는 커밋하지 않는다(.gitignore). 이 예제 파일에는 실제 값을 넣지 않는다.
#
# 아래에 없는 knob 도 그대로 쓸 수 있다. 코드가 읽는 전체 목록:
#   git grep -hoE "os\.(getenv|environ\.get)\(\s*\"[A-Z0-9_]+\"" -- '*.py' | sort -u

# =============================================================================
# 프로필 / 앱
# =============================================================================
# development | production (기본값 production — env 없이 뜨던 배포 호환)
VALUE_INVEST_ENV=production
APP_TITLE=Value Compass
# 프런트만 GitHub Pages 로 배포할 때 참조하는 공개 API 주소.
PUBLIC_API_BASE_URL=
# 미설정 시 core/config.py 의 DEFAULT_CORS_ORIGINS 사용.
CORS_ALLOWED_ORIGINS=
# 기본값: development=1, production=0
ENABLE_API_DOCS=

# =============================================================================
# 시크릿 (실제 값은 절대 커밋하지 않는다)
# =============================================================================
# 세션 쿠키 서명 키. 비어 있으면 로그인 기능 자체가 꺼진다.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
# OpenRouter — 관리자 화면(DB 설정)이 이 값보다 우선한다.
OPENROUTER_API_KEY=
# DART 공시/재무. https://opendart.fss.or.kr
OPENDART_API_KEY=
# 한국은행 ECOS — 국고채·통안채·KOFR 지표. 없으면 해당 지표만 빈다.
ECOS_API_KEY=
# 내부 루프백 엔드포인트(systemd timer)용 토큰.
INTERNAL_API_TOKEN=
# ePaper 디바이스 읽기 전용 API.
DEVICE_API_TOKEN=
DEVICE_USER_EMAIL=

# =============================================================================
# 알림 (텔레그램 / 카카오)
# =============================================================================
#   - 채널 자격증명은 '사용자별'로 등록한다(알림 모달에서 각자 봇 토큰/REST 키 입력).
#     아래 값들은 선택적 '공용 fallback' 일 뿐, 없어도 사용자별 등록은 동작한다.
#   - NOTIFY_ALERT_INTERVAL_S > 0 이어야 주기 평가 루프가 돈다(예: 300=5분, 0=중지).
NOTIFY_ALERT_INTERVAL_S=0
NOTIFY_ALERT_INITIAL_DELAY_S=30
TELEGRAM_BOT_TOKEN=
# KAKAO_REDIRECT_URI 는 카카오 콘솔에 등록한 값과 정확히 일치해야 한다(미설정 시
# PUBLIC_API_BASE_URL 또는 요청 host 로 유추).
#   예) https://cantabile.tplinkdns.com:3691/api/notifications/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=

# =============================================================================
# AI (OpenRouter 등급별 모델)
# =============================================================================
# 기능은 LOCAL/LIGHT/BALANCED/PREMIUM 등급만 참조한다. 관리자 DB 설정 > 아래 env >
# 코드 기본값 순으로 적용된다.
AI_LIGHT_MODEL=qwen/qwen3.6-flash
AI_BALANCED_MODEL=google/gemini-3.5-flash
AI_PREMIUM_MODEL=openai/gpt-5.6-terra
PORTFOLIO_AI_MAX_TOKENS=8000
PORTFOLIO_AI_PREMIUM_REASONING_EFFORT=medium
MARKET_DAILY_CACHE_TTL_MINUTES=30
# 일일 USD 상한(0=비활성). 초과하면 새 호출만 429 로 막는다.
AI_DAILY_BUDGET_USD=0
AI_USER_DAILY_BUDGET_USD=0

# =============================================================================
# 백그라운드 루프 (운영은 systemd timer 기준 — 앱 내 루프는 기본 꺼짐)
# =============================================================================
WIKI_INGEST_INTERVAL_S=0
WIKI_PER_STOCK_LIMIT=50
DART_REVIEW_INTERVAL_S=0
PORTFOLIO_INSIGHT_STARTUP_WARMUP=0

# =============================================================================
# 외부 데이터 소스
# =============================================================================
# 로컬 종가 API. 실시간 현재가 경로는 별도 피드를 쓴다.
CLOSE_PRICE_API_BASE_URL=http://192.168.68.84:8400
CLOSE_PRICE_API_TIMEOUT_SECONDS=2.5
CLOSE_PRICE_API_ENABLED=1
# KIS proxy 호환 경로.
KIS_PROXY_BASE_URL=http://cantabile.tplinkdns.com:3288
KIS_PROXY_TIMEOUT_SECONDS=20
KIS_PROXY_RATE_PER_SEC=4
# KIS 실시간 WebSocket 키 풀. 2번째부터는 KIS_APP_KEY2/KIS_APP_SECRET2 …
KIS_BASE_URL=
KIS_APP_KEY=
KIS_APP_SECRET=

# =============================================================================
# 관측성
# =============================================================================
# /api/* 요청이 이 값(ms)보다 느리면 system_events(source="http") 에 기록한다.
SLOW_REQUEST_MS=1000
