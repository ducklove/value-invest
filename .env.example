# value-invest 설정 단일 소스 — 이 파일을 `.env` 로 복사해서 채운다.
#
# 규칙
#   - 설정과 시크릿은 전부 `.env` 하나에 둔다. 프로필별 파일(.env.production 등)
#     이나 keys.txt 같은 별도 파일은 더 이상 읽지 않는다.
#   - 프로세스 환경변수(systemd `Environment=`, 쉘 export, 테스트의 patch.dict)가
#     `.env` 보다 우선한다. `.env` 는 비어 있는 키만 채운다.
#   - 새 설정을 추가하면 코드 기본값에만 두지 말고 여기에 먼저 문서화한다.
#   - `.env` 는 커밋하지 않는다(.gitignore). 이 예제 파일에는 실제 값을 넣지 않는다.
#
# 아래에 없는 knob 도 그대로 쓸 수 있다. 코드가 읽는 전체 목록:
#   git grep -hoE "os\.(getenv|environ\.get)\(\s*\"[A-Z0-9_]+\"" -- '*.py' | sort -u

# =============================================================================
# 프로필 / 앱
# =============================================================================
# development | production (기본값 production — env 없이 뜨던 배포 호환)
VALUE_INVEST_ENV=production
APP_TITLE=Value Compass
# 프런트만 GitHub Pages 로 배포할 때 참조하는 공개 API 주소.
PUBLIC_API_BASE_URL=
# 미설정 시 core/config.py 의 DEFAULT_CORS_ORIGINS 사용.
CORS_ALLOWED_ORIGINS=

# NH 사용자별 키는 포트폴리오 계좌 관리에서 등록한다. 자동매매는 지원하지 않는다.
NAMUH_WS_MAX_REGISTRATIONS=30
# 둘 다 미설정이면 DB 디렉터리에 .broker-encryption.key 를 권한 0600으로 생성한다.
# 이 파일은 DB와 분리해 안전하게 백업하고 배포·복구 시 보존해야 한다.
BROKER_KEY_FILE=
# Fernet 키를 환경으로 제공할 때만 설정. 키 값은 저장소에 커밋하지 않는다.
BROKER_ENCRYPTION_KEY=
# 브라우저 변경 요청(POST/PUT/PATCH/DELETE)의 출처 검증에도 사용한다.
# 설정 시 실제 접속 Origin을 포트까지 포함하며, 기존 기본 목록을 대체한다.
# 기본값: development=1, production=0
ENABLE_API_DOCS=
# 운영 TLS: uvicorn 이 /etc/letsencrypt/live/<TLS_CERT_NAME>/ 의 인증서로 직접
# HTTPS 를 종단한다(deploy/run_app.sh). 접속 도메인을 옮기면 certbot 으로 새
# 도메인 인증서를 먼저 발급한 뒤 이 값을 바꾼다. 기본값 ducklove.duckdns.org
TLS_CERT_NAME=

# =============================================================================
# 시크릿 (실제 값은 절대 커밋하지 않는다)
# =============================================================================
# 세션 쿠키 서명 키. 비어 있으면 로그인 기능 자체가 꺼진다.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
# OpenRouter — 관리자 화면(DB 설정)이 이 값보다 우선한다.
OPENROUTER_API_KEY=
# DART 공시/재무. https://opendart.fss.or.kr
OPENDART_API_KEY=
# 한국은행 ECOS — 국고채·통안채·KOFR 지표. 없으면 해당 지표만 빈다.
ECOS_API_KEY=
# /api/internal/* 교차 호스트 호출용 토큰(finance-pi, buybacks 등 → X-Internal-Token 헤더).
# 같은 호스트 systemd timer 의 직접 loopback 호출(127.0.0.1, 프록시 헤더 없음)은
# 이 값 설정 여부와 무관하게 토큰 없이 허용된다. 프록시를 거쳤거나(X-Forwarded-For/
# X-Real-IP/Forwarded) 다른 호스트에서 온 요청은 유효한 토큰이 있어야 한다.
# 비어 있으면 토큰 인증은 꺼지고 직접 loopback 만 허용된다.
INTERNAL_API_TOKEN=
# ePaper 디바이스 읽기 전용 API.
DEVICE_API_TOKEN=
DEVICE_USER_EMAIL=

# =============================================================================
# 알림 (텔레그램 / 카카오)
# =============================================================================
#   - 채널 자격증명은 '사용자별'로 등록한다(알림 모달에서 각자 봇 토큰/REST 키 입력).
#     아래 값들은 선택적 '공용 fallback' 일 뿐, 없어도 사용자별 등록은 동작한다.
#   - NOTIFY_ALERT_INTERVAL_S > 0 이어야 주기 평가 루프가 돈다(예: 300=5분, 0=중지).
NOTIFY_ALERT_INTERVAL_S=0
NOTIFY_ALERT_INITIAL_DELAY_S=30
TELEGRAM_BOT_TOKEN=
# KAKAO_REDIRECT_URI 는 카카오 콘솔에 등록한 값과 정확히 일치해야 한다(미설정 시
# PUBLIC_API_BASE_URL 또는 요청 host 로 유추).
#   예) https://ducklove.duckdns.org:3691/api/notifications/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=

# =============================================================================
# AI (OpenRouter 등급별 모델)
# =============================================================================
# 기능은 LOCAL/LIGHT/BALANCED/PREMIUM 등급만 참조한다. 관리자 DB 설정 > 아래 env >
# 코드 기본값 순으로 적용된다.
AI_LIGHT_MODEL=qwen/qwen3.6-flash
AI_BALANCED_MODEL=google/gemini-3.5-flash
AI_PREMIUM_MODEL=openai/gpt-5.6-terra
PORTFOLIO_AI_MAX_TOKENS=8000
PORTFOLIO_AI_PREMIUM_REASONING_EFFORT=medium
MARKET_DAILY_CACHE_TTL_MINUTES=30
# 일일 USD 상한(0=비활성). 초과하면 새 호출만 429 로 막는다.
AI_DAILY_BUDGET_USD=0
AI_USER_DAILY_BUDGET_USD=0

# =============================================================================
# 백그라운드 루프 (운영은 systemd timer 기준 — 앱 내 루프는 기본 꺼짐)
# =============================================================================
WIKI_INGEST_INTERVAL_S=0
WIKI_PER_STOCK_LIMIT=50
DART_REVIEW_INTERVAL_S=0
PORTFOLIO_INSIGHT_STARTUP_WARMUP=0
# 정규장 평가: 기본 15:30 기준 / 15:35 실행. 확인된 임시 휴장(null)·마감시간만
# YYYY-MM-DD → HH:MM 으로 지정한다. 예: {"2026-11-19":"16:30"}
# 수능일은 공지 확인·설정 전까지 정산을 보류한다. 임의 시각이면 timer도 맞춘다.
# (미설정 수능일 후보가 30일 안에 들어오면 data-quality 점검이
#  market_calendar_coverage WARN 으로 알린다 — KRX 공지 시각을 그대로 넣을 것.)
PORTFOLIO_MARKET_SESSIONS={}

# =============================================================================
# 외부 데이터 소스
# =============================================================================
# finance-pi 내부 API(종가·일봉·거시지표·기초재무·스크리너·퀀트 연구).
# 실시간 현재가 경로는 별도 피드를 쓴다. services/market/sources/finance_pi.py 가
# 읽는다. 표준 이름은 FINANCE_PI_*; 구 이름 CLOSE_PRICE_API_BASE_URL /
# CLOSE_PRICE_API_TOKEN 도 계속 동작한다. 둘 다 있으면 기존 운영값 보존을 위해
# 구 이름이 우선하므로, 새 이름으로 옮길 때는 구 이름 줄을 지운다.
FINANCE_PI_BASE_URL=http://192.168.68.84:8400
# finance-pi 관리 토큰(X-Admin-Token). 비우면 헤더를 보내지 않는다.
FINANCE_PI_API_TOKEN=
CLOSE_PRICE_API_ENABLED=1
CLOSE_PRICE_API_TIMEOUT_SECONDS=2.5
# 기초재무 조회 기본 timeout(여러 종목이면 종목당 +1.5s, 최대 20s).
CLOSE_PRICE_API_FUNDAMENTALS_TIMEOUT_SECONDS=6.0
# 가격·거시 조회(전체 이력 포함) 제한 시간. 초과하면 쿨다운 후 다른 소스로 넘어간다.
CLOSE_PRICE_API_PRICE_TIMEOUT_SECONDS=10
# 가격 조회 5xx/429/연결 실패 뒤 finance-pi 가격 호출을 쉬는 시간(초).
CLOSE_PRICE_API_FAILURE_COOLDOWN_SECONDS=60
# KIS proxy 호환 경로. 비워 두면 운영 프로필(프로필 미지정 포함)은 http://127.0.0.1:3288,
# 그 외 프로필은 공개 주소를 쓴다. 값이 있으면 항상 이긴다 — 운영 Pi 에서는 비워 두거나 루프백으로.
# KIS_PROXY_BASE_URL=http://127.0.0.1:3288
KIS_PROXY_TIMEOUT_SECONDS=20
KIS_PROXY_RATE_PER_SEC=4
# 기존 KIS REST/호환용 설정. 실시간 시세는 로그인 사용자의 연결 계좌 앱키를 사용한다.
KIS_BASE_URL=
KIS_APP_KEY=
KIS_APP_SECRET=
# 서버 공통 실시간 시세 모듈의 토스 인증정보. 계좌 조회·주문에는 사용하지 않는다.
# 토스 WTS Open API 설정에서 서버의 외부 IP를 허용해야 한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# =============================================================================
# 관측성
# =============================================================================
# /api/* 요청이 이 값(ms)보다 느리면 system_events(source="http") 에 기록한다.
SLOW_REQUEST_MS=1000
