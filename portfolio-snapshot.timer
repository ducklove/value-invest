[Unit]
Description=Regular-close settlement at 15:35 KST with immutable-input retries

[Timer]
OnCalendar=Mon..Fri *-*-* 15:35,37,39,45,55:00 Asia/Seoul
# Explicit calendar overrides can move the close to 16:30 (e.g. announced exam-day hours).
OnCalendar=Mon..Fri *-*-* 16:35,37,39,45:00 Asia/Seoul
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
