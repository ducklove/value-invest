[Unit]
Description=Data-quality checks after regular-close settlement and after-market capture

[Timer]
# 정규장 정산과 저녁 자료 갱신 후 점검. 놓친 점검은 부팅 후 따라잡는다.
OnCalendar=*-*-* 15:43:00 Asia/Seoul
OnCalendar=*-*-* 16:43:00 Asia/Seoul
OnCalendar=*-*-* 20:30:00 Asia/Seoul
Persistent=true
RandomizedDelaySec=2m

[Install]
WantedBy=timers.target
